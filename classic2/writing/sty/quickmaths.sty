% Heading-like \note and \separate (ported from V1/mathhw.sty).
% \note emits a centered bold header with hrule above and writes a TOC entry
% so a \tableofcontents call can render it.
\newcommand{\note}[1]{%
    \vspace{0.4cm}%
    \hrule
    \vspace{-0.2cm}%
    \noindent
    \begin{center}
        \textbf{#1}
    \end{center}
    \vspace{-0.4cm}%
    \addcontentsline{toc}{section}{#1}%
}

\newcommand{\separate}{%
    \vspace{-0.6em}%
    {\centering
    \line(1,0){200}\\
    \par}%
}

% --- Physics-package substitute notation ---
% Paired delimiters (\abs, \norm, \parens, \bracks, \braces) are already
% declared above with \DeclarePairedDelimiter; do not redeclare here.

% Starred/auto-sized aliases, inspired by the arXiv macros style
\newcommand{\Abs}[1]{\abs*{#1}}
\newcommand{\Norm}[1]{\norm*{#1}}
\newcommand{\Par}[1]{\parens*{#1}}
\newcommand{\Brack}[1]{\bracks*{#1}}
\newcommand{\Brace}[1]{\braces*{#1}}

% Inner products
\newcommand{\inprod}[2]{\left\langle #1, #2 \right\rangle}
\newcommand{\inprods}[2]{\langle #1, #2 \rangle}

% Dirac notation: fixed-size
\newcommand{\ket}[1]{\lvert #1 \rangle}
\newcommand{\bra}[1]{\langle #1 \rvert}
\newcommand{\braket}[2]{\langle #1 \mid #2 \rangle}
\newcommand{\ketbra}[2]{\lvert #1 \rangle\!\langle #2 \rvert}
\newcommand{\mel}[3]{\langle #1 \rvert #2 \lvert #3 \rangle}

% Dirac notation: auto-sized
\newcommand{\Ket}[1]{\left\lvert #1 \right\rangle}
\newcommand{\Bra}[1]{\left\langle #1 \right\rvert}
\newcommand{\Braket}[2]{\left\langle #1 \middle| #2 \right\rangle}
\newcommand{\Ketbra}[2]{\left\lvert #1 \right\rangle\!\left\langle #2 \right\rvert}
\newcommand{\Mel}[3]{\left\langle #1 \middle| #2 \middle| #3 \right\rangle}

