%=====New Sections mimicing \note============
\usepackage{titlesec}

\titleformat{\section}[block]          % [block] is the standard section title style
  {\bfseries\large} % Font styling (bold + normal size)
  {} % No subsection number label
  {0 pt} % Spacing between label and title
  {\centering} % before block
  [\vspace{-0.2cm}] % after block

\titleformat{\subsection}[block]          % [block] is the standard section title style
  {\bfseries\normalsize}                 % Font styling (bold + normal size)
  {}                                     % No subsection number
  {0pt}                                  % Spacing between label and title
  {%
    \vspace{-0.1cm}%                     % Add spacing before rule
    \hrule%                              % Horizontal rule
    \vspace{0.1cm}%                    % Adjust vertical spacing
    \centering%                          % Center the subsection title
  }%
  [\vspace{-0.4cm}]                      % Negative spacing after the title block

\titleformat{\subsubsection}[block]          % [block] is the standard section title style
  {\bfseries\normalsize} % Font styling (bold + normal size)
  {\thesubsubsection} % No subsection number label
  {1em} % Spacing between label and title
  {} % before block
  [\vspace{-0.2cm}] % after block



%=====Question "environment"=================
\newcommand{\note}[1]{
\vspace{0.4 cm}
\hrule
\vspace{-0.2 cm}
\noindent
\begin{center}
    \textbf{#1}
\end{center}
\vspace{-0.4 cm}
}

%https://tex.stackexchange.com/questions/215555/how-can-i-remove-vertical-spacing-around-a-centered-element
\newcommand{\separate}{
\vspace{-0.6em}
{\centering
\line(1,0){200}\\
\par}
}

\newcommand{\headrule}{
    \vspace{-0.1 cm}
    \hrule
    \vspace{0.2 cm}
}


