% for boldface of math commands, we use bm
\usepackage{bm} % in your preamble

\newcommand{\detv}[1]{#1}
\newcommand{\rv}[1]{\mathsf{#1}}
\newcommand{\detvec}[1]{\mathbf{#1}}        % Bold serif
\newcommand{\rvec}[1]{\bm{\mathsf{#1}}}     % Bold sans-serif

\begin{comment}
437 Notation: 

$\mathbf{x}$ : bold serif (deterministic vector)
$\bm{\mathsf{x}}$: bold san serif (random vector)
$\mathrm{x}$: serif ( not used?)
$\mathsf{x}$: sans serif (random variable)
$x$: normal (deterministic value)
\end{comment}


\newcommand{\zset}[1]{\{0, \ldots, {#1}\}}


\newcommand{\E}{\mathbb{E}}
\newcommand{\expect}[1]{
\mathbb{E}\left[ #1 \right]
}
\newcommand{\expectsubscript}[2]{
\mathbb{E}_{#1} \left[ #2\right]
}
% \newcommand{\norm}[1]{\left \lvert #1 \right \rvert}


\newcommand{\Ebrackets}[1]{%
\mathbb{E} \left[ #1 \right]%
}


%shorthand for partial derivatives
\newcommand{\p}{
    \partial
}
%shorthand for a full partial
\newcommand{\pf}[2]{
    \frac{\p #1}{\p #2}
}

\newcommand{\der}{
    \frac{d}{dx}
}

%ceiling function
\newcommand{\ceil}[1]{
    \lceil #1 \rceil
}



\newcommand{\blue}[1]{
