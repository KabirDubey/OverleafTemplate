%=====Question "environment"=================
\newcommand{\note}[1]{
\vspace{0.4 cm}
\hrule
\vspace{-0.2 cm}
\noindent
\begin{center}
    \textbf{#1}
\end{center}
\vspace{-0.4 cm}
}

\newcommand{\bluebox}[1]{
    \begin{tcolorbox}[width=\textwidth,colback={ProcessBlue!10}, parbox=false]    
        #1
    \end{tcolorbox}
}
\newcommand{\greenbox}[1]{
    \begin{tcolorbox}[width=\textwidth,colback={LimeGreen!10}, parbox=false]    
        #1
    \end{tcolorbox}
}
\newcommand{\yellowbox}[1]{
    \begin{tcolorbox}[width=\textwidth,colback={Goldenrod!15}, parbox=false]    
        #1
    \end{tcolorbox}
}
\newcommand{\pinkbox}[1]{
    \begin{tcolorbox}[width=\textwidth,colback={CarnationPink!15}, parbox=false]    
        #1
    \end{tcolorbox}
}
\newcommand{\graybox}[1]{
    \begin{tcolorbox}[width=\textwidth,colback={Gray!15}, parbox=false]    
        #1
    \end{tcolorbox}
}

\newcommand{\boxspace}[1]{
    \vspace{1em}
}
\newcommand{\todo}[1]{\textbf{\textcolor{red}{TODO:}} \textcolor{red}{#1}}


%shorthand for partial derivatives
\newcommand{\p}{
    \partial
}
%shorthand for a full partial
\newcommand{\pf}[2]{
    \frac{\p #1}{\p #2}
}

\newcommand{\cl}[1]{
    \text{cl}\left( #1 \right)
}


%ceiling function
\newcommand{\ceil}[1]{
    \lceil #1 \rceil
}


%https://tex.stackexchange.com/questions/215555/how-can-i-remove-vertical-spacing-around-a-centered-element
\newcommand{\separate}{
\vspace{-1em}
{\centering
\line(1,0){200}\\
\par}
}
